DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set DATABASE_ENGINE=postgresql setelah PostgreSQL siap digunakan.
DATABASE_ENGINE=sqlite
POSTGRES_DB=antikopas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

OPENALEX_API_KEY=replace-with-openalex-api-key
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
